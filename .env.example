# Attacca CLI configuration
# Copy this file to .env and fill in what you need.
#
# Against the hosted deployment there is nothing to set at all: the node enrolls itself on first
# run, prints a short code, and stores the credential in ~/.config/zyris/.

# ── Zyris ─────────────────────────────────────────────────────────────────────

# Optional: websocket URL (default: wss://attacca.cc/api/zyris/v1/ws)
# A local server is ws://127.0.0.1:8080/zyris/v1/ws
# ZYRIS_SERVER_URL=

# Optional: a static node token, for machines provisioned without a human present.
# Must be a znt_ token — an atk_ REST API key will not work here.
# ZYRIS_NODE_TOKEN=znt_...

# Optional: read the token from a file instead (re-read on every dial)
# ZYRIS_NODE_TOKEN_FILE=

# Optional: the name proposed at enrollment (default: this machine's hostname)
# ZYRIS_NODE_NAME=

# Optional: scopes to request
# (default: agents:read,projects:read,sessions:read,sessions:write,events:read)
# events:read is what turn streaming needs.
# ZYRIS_SCOPES=

# Optional: name the credential file, so one machine can hold separate identities
# ZYRIS_PROFILE=default

# Optional: where credentials live (default: XDG config dir)
# ZYRIS_CONFIG_DIR=

# ── Attacca ───────────────────────────────────────────────────────────────────

# Optional: agent UUID for new sessions (default: the first agent listed)
# ATTACCA_AGENT=

# Optional: project name or UUID for new sessions (default: the account default)
# ATTACCA_PROJECT=my-project

# Optional: working directory for file_io and terminal (default: where you launched from).
# Relative paths resolve against it; absolute paths and ".." still reach outside, so this is a
# starting point rather than a sandbox.
# ATTACCA_FILE_ROOT=

# Optional: set to omit the terminal capability, so only file_io is announced
# ATTACCA_NO_TERMINAL=1

# Optional: log to a file. Without this nothing is logged, because stdout is the TUI.
# ATTACCA_LOG=attacca-cli.log

# Optional: show unrecognised session events, for discovering what a deployment emits
# ATTACCA_DEBUG_EVENTS=1
