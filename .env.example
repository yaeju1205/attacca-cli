# attacca-cli configuration — every value here is optional.
# Copy to .env and uncomment what you need.
#
# There is no API key any more. attacca-cli authenticates as a Zyris node: on first run it
# prints a short code to approve in a browser, and stores the credential under ~/.config/zyris.

# ── Zyris ─────────────────────────────────────────────────────────────────────

# The server to dial (default: wss://attacca.cc/api/zyris/v1/ws)
# ZYRIS_SERVER_URL=ws://127.0.0.1:8080/zyris/v1/ws

# A pre-provisioned node token, which skips enrollment entirely. Use this for headless
# or CI runs, where nobody is present to approve a code.
# ZYRIS_NODE_TOKEN=znt_...

# Same, read from a file. Re-read on every dial, so rotating the secret needs no restart.
# ZYRIS_NODE_TOKEN_FILE=/run/secrets/zyris-node-token

# How this machine names itself to the account (default: its hostname)
# ZYRIS_NODE_NAME=build-box

# What to ask for at enrollment. Dropping events:read leaves the chat with no turn feed
# at all — the client says so on connect, but it is an easy thing to break.
# ZYRIS_SCOPES=agents:read projects:read sessions:read sessions:write events:read

# ZYRIS_PROFILE=default
# ZYRIS_CONFIG_DIR=~/.config/zyris

# ── Attacca ───────────────────────────────────────────────────────────────────

# Which agent new sessions run against — a name or a UUID (default: the first one).
# A value matching neither is reported rather than silently ignored.
# ATTACCA_AGENT=Researcher

# Which project new sessions are filed under — a name or a UUID (default: the account default).
# ATTACCA_PROJECT=my-project

# Where relative paths from file_io and terminal resolve (default: the current directory).
# NOT a sandbox: absolute paths are honoured as given and `..` climbs out.
# ATTACCA_FILE_ROOT=/home/me/project

# Announce file_io only, without terminal. The agent is told accordingly.
# ATTACCA_NO_TERMINAL=1

# Where to log. Without this nothing is logged at all, because stdout is the TUI.
# ATTACCA_LOG=attacca-cli.log

# Render durable event kinds the client does not recognise, for when a session opens blank.
# ATTACCA_DEBUG_EVENTS=1

# Drop "thinking" cards from the transcript.
# ATTACCA_HIDE_REASONING=1
