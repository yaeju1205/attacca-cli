# Attacca CLI configuration
# Copy this file to .env and fill in your values.

# Required: Get your API key at https://attacca.cc → Settings → API keys
ATTACCA_API_KEY=atk_your_key_here

# Optional: API base URL (default: https://attacca.cc/api/v1)
# ATTACCA_API_URL=https://attacca.cc/api/v1

# Optional: Default project (name or UUID)
# ATTACCA_PROJECT=my-project

# Optional: Agent UUID
# ATTACCA_AGENT=
